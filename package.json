{
  "name": "@isai_dev/data_table_lib",
  "version": "2.0.0-alpha.1",
  "description": "Accessible React tables with editable cells and row actions",
  "author": {
    "name": "Jaziel Isaí",
    "url": "https://isai-dev.com"
  },
  "license": "MIT",
  "homepage": "https://jazielisai.github.io/data_table_lib/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JazielIsai/data_table_lib.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "start": "vite",
    "presite": "npm run build",
    "site": "vite --config vite.site.config.js",
    "build:site": "npm run build && vite build --config vite.site.config.js",
    "preexamples": "npm run build",
    "examples": "vite",
    "build": "node scripts/build.mjs",
    "test": "npm run build && tsc --noEmit -p tsconfig.types.json && node --test tests/*.test.mjs",
    "typecheck": "npm run build && tsc --noEmit -p tsconfig.types.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
